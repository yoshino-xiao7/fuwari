---

import MainGridLayout from "../layouts/MainGridLayout.astro";

import { getEntry } from "astro:content";
import { render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import { identityConfig, profileConfig, siteConfig } from "../config";
import { getAbsoluteUrl, jsonLdString } from "../utils/seo-utils";

const aboutPost = await getEntry("spec", "about");
const aboutDescription =
	"关于雪涼（YukiRyou）和个人博客「雪涼的扣扣空间」：记录个人项目、技术实践、雪涼云开发日志与日常内容。";

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);

const aboutUrl = getAbsoluteUrl("/about/", Astro.site);
const homeUrl = getAbsoluteUrl("/", Astro.site);
const profilePageId = getAbsoluteUrl("/about/#profile", Astro.site);
const personId = getAbsoluteUrl("/about/#person", Astro.site);
const websiteId = getAbsoluteUrl("/#website", Astro.site);

const profileJsonLd = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"@id": profilePageId,
	name: `关于${identityConfig.primaryName}`,
	description: aboutDescription,
	url: aboutUrl,
	inLanguage: siteConfig.lang.replace("_", "-"),
	isPartOf: {
		"@type": "WebSite",
		"@id": websiteId,
		name: identityConfig.siteName,
		alternateName: identityConfig.siteAliases,
		url: homeUrl,
	},
	mainEntity: {
		"@type": "Person",
		"@id": personId,
		name: identityConfig.primaryName,
		alternateName: identityConfig.personAliases,
		url: aboutUrl,
		image: profileConfig.avatar,
		sameAs: profileConfig.links.map((link) => link.url),
		mainEntityOfPage: {
			"@id": profilePageId,
		},
		subjectOf: {
			"@type": "WebSite",
			"@id": websiteId,
			name: identityConfig.siteName,
			url: homeUrl,
		},
		knowsAbout: identityConfig.topics,
	},
};
---
<MainGridLayout title="关于雪涼" description={aboutDescription}>
    <script is:inline slot="head" type="application/ld+json" set:html={jsonLdString(profileJsonLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
