---
import ArchivePanel from "@components/ArchivePanel.astro";

import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";

export async function getStaticPaths() {
	const posts = await getSortedPosts();

	// タグを集めるための Set の型を指定
	const allTags = posts.reduce<Set<string>>((acc, post) => {
		// biome-ignore lint/complexity/noForEach: <explanation>
		post.data.tags.forEach((tag) => acc.add(tag));
		return acc;
	}, new Set());

	const allTagsArray = Array.from(allTags);

	return allTagsArray.map((tag) => ({
		params: {
			tag: tag,
		},
	}));
}

const tag = Astro.params.tag as string;
---

<MainGridLayout
    title={`${tag}相关文章与技术记录`}
    description={`浏览雪涼（YukiRyou）发布的${tag}相关文章，涵盖开发实践、项目记录、技术分享与个人经验，相关内容会持续整理和更新。`}
>
    <h1 class="sr-only">{tag} 标签文章归档</h1>
    <ArchivePanel tags={[tag]}></ArchivePanel>
</MainGridLayout>
