---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

const projectNames: Record<string, string> = {
	xueliangyun: "雪涼云",
	"endfield-yunzai": "终末地 Yunzai 插件",
};

const devlogs = (await getCollection("devlogs")).sort(
	(a, b) =>
		new Date(b.data.published).getTime() - new Date(a.data.published).getTime(),
);

const groups = devlogs.reduce(
	(acc, log) => {
		const project = log.data.project;
		if (!acc[project]) {
			acc[project] = [];
		}
		acc[project].push(log);
		return acc;
	},
	{} as Record<string, typeof devlogs>,
);

const sortedProjects = Object.keys(groups).sort((a, b) =>
	(projectNames[a] || a).localeCompare(projectNames[b] || b),
);
---

<MainGridLayout title="开发日志" description="项目开发日志与版本更新记录">
    <div class="card-base px-6 py-6 md:px-8">
        <div class="mb-6 flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--primary)] text-white dark:text-black/70">
                <Icon name="material-symbols:history-rounded" class="text-[1.5rem]" />
            </div>
            <div>
                <h1 class="text-2xl font-bold text-black dark:text-white">开发日志</h1>
                <p class="mt-1 text-sm text-black/50 dark:text-white/50">项目版本、重构和发布记录</p>
            </div>
        </div>

        <div class="flex flex-col gap-7">
            {sortedProjects.map((project) => (
                <section>
                    <div class="mb-3 flex items-center justify-between gap-3">
                        <h2 class="text-lg font-bold text-black/85 dark:text-white/90">
                            {projectNames[project] || project}
                        </h2>
                        <span class="rounded-full bg-[var(--btn-regular-bg)] px-2.5 py-1 text-xs font-semibold text-[var(--btn-content)]">
                            {groups[project].length} 条
                        </span>
                    </div>

                    <div class="flex flex-col divide-y divide-black/10 dark:divide-white/10">
                        {groups[project].map((log) => (
                            <a
                                href={`/devlogs/${log.slug}/`}
                                class="group grid gap-2 py-4 transition hover:text-[var(--primary)] md:grid-cols-[8rem_minmax(0,1fr)]"
                            >
                                <time class="text-sm font-semibold text-[var(--primary)]">
                                    {formatDateToYYYYMMDD(log.data.published)}
                                </time>
                                <div class="min-w-0">
                                    <div class="font-bold text-black/80 transition group-hover:text-[var(--primary)] dark:text-white/85">
                                        {log.data.title}
                                    </div>
                                    {log.data.summary && (
                                        <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-black/50 dark:text-white/50">
                                            {log.data.summary}
                                        </p>
                                    )}
                                </div>
                            </a>
                        ))}
                    </div>
                </section>
            ))}
        </div>
    </div>
</MainGridLayout>
