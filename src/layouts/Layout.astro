---
/**
 * Layout.astro — 站点布局骨架
 *
 * 职责：组合各子组件，处理 banner 相关样式
 * 子组件拆分：
 *   - HeadMeta: meta 标签、favicon、OG
 *   - ThemeInit: 主题初始化 inline script + 背景图 CSS 变量
 *   - AnalyticsScripts: Cookie 同意 + 分析脚本
 *   - DomainChecker: 域名安全检测
 */
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";

import { identityConfig, profileConfig, siteConfig } from "@/config";
import ConfigCarrier from "@components/ConfigCarrier.astro";
import DomainChecker from "@components/DomainChecker.astro";
import AnalyticsScripts from "@components/analytics/AnalyticsScripts.astro";
import HeadMeta from "@components/head/HeadMeta.astro";
import ThemeInit from "@components/head/ThemeInit.astro";
import MusicPlayer from "@components/music/MusicPlayer.svelte";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
} from "../constants/constants";
import {
	getAbsoluteUrl,
	getCanonicalUrl,
	jsonLdString,
} from "../utils/seo-utils";
import { url, pathsEqual } from "../utils/url-utils";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	ogImage?: string;
	ogImageAlt?: string;
	robots?: string;
	articlePublished?: Date;
	articleModified?: Date;
	articleSection?: string;
	articleTags?: string[];
}

let {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	ogImage,
	ogImageAlt,
	robots,
	articlePublished,
	articleModified,
	articleSection,
	articleTags,
} = Astro.props;

// Banner
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}
// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;
const enableBanner = siteConfig.banner.enable;

// Page title
let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	if (siteConfig.subtitle && siteConfig.subtitle.trim() !== "") {
		pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
	} else {
		pageTitle = siteConfig.title;
	}
}

// Meta description fallback
if (!description) {
	description = siteConfig.description || pageTitle;
}

// Language
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

// Banner offset
const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];

// Background image CSS variables — injected inline to avoid depending on external CSS loading
const bgStyle = [
	"--bg-url: none",
	`--bg-enable: ${siteConfig.background.enable ? "1" : "0"}`,
	`--bg-position: ${siteConfig.background.position || "center"}`,
	`--bg-size: ${siteConfig.background.size || "cover"}`,
	`--bg-repeat: ${siteConfig.background.repeat || "no-repeat"}`,
	`--bg-attachment: ${siteConfig.background.attachment || "fixed"}`,
	`--bg-opacity: ${siteConfig.background.opacity || 0.3}`,
].join(";");

const homeUrl = getCanonicalUrl("/", Astro.site);
const aboutUrl = getAbsoluteUrl("/about/", Astro.site);
const websiteId = getAbsoluteUrl("/#website", Astro.site);
const personId = getAbsoluteUrl("/about/#person", Astro.site);
const personJsonLd = {
	"@type": "Person",
	"@id": personId,
	name: identityConfig.primaryName,
	alternateName: identityConfig.personAliases,
	url: aboutUrl,
	image: profileConfig.avatar,
	sameAs: profileConfig.links.map((link) => link.url),
	knowsAbout: identityConfig.topics,
};
const siteJsonLd = isHomePage
	? {
			"@context": "https://schema.org",
			"@type": "WebSite",
			"@id": websiteId,
			name: identityConfig.siteName,
			alternateName: [identityConfig.siteName, ...identityConfig.siteAliases],
			url: homeUrl,
			description: siteConfig.description || siteConfig.subtitle,
			inLanguage: siteConfig.lang.replace("_", "-"),
			about: personJsonLd,
			author: personJsonLd,
			publisher: personJsonLd,
		}
	: null;
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]"
	  data-overlayscrollbars-initialize
	  style={bgStyle}
>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<ThemeInit />
		<HeadMeta
			pageTitle={pageTitle}
			description={description!}
			setOGTypeArticle={setOGTypeArticle}
			ogImage={ogImage}
			ogImageAlt={ogImageAlt}
			robots={robots}
			articlePublished={articlePublished}
			articleModified={articleModified}
			articleSection={articleSection}
			articleTags={articleTags}
		/>
		{siteJsonLd && <script is:inline type="application/ld+json" set:html={jsonLdString(siteJsonLd)}></script>}
		<slot name="head" />
	</head>

	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		<a href="#swup-container" class="skip-link">跳到正文</a>
		<div id="reading-progress" class="pointer-events-none fixed left-0 top-0 z-[9999] h-[3px] w-full opacity-0 transition-opacity duration-200" aria-hidden="true">
			<div id="reading-progress-fill" class="h-full w-full origin-left scale-x-0 bg-[var(--primary)]"></div>
		</div>
		<div id="bg-layer"></div>
		<ConfigCarrier />
		<slot />

		<!-- 全局音乐播放器与灵动岛 (Svelte 5) -->
		<MusicPlayer client:idle />

		<!-- 页面过渡期间撑高页面，防止滚动跳动 -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>

		<DomainChecker />
		<AnalyticsScripts />
	</body>
</html>

<!-- Banner 相关全局样式 -->
<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
	#reading-progress-fill {
		transform: scaleX(var(--reading-progress, 0));
		box-shadow: 0 0 12px oklch(0.68 0.18 var(--hue) / 0.55);
	}
}
</style>

<style is:global>
	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 10000;
		transform: translateY(-200%);
		border-radius: 0.5rem;
		background: var(--card-bg);
		color: var(--primary);
		padding: 0.75rem 1rem;
		font-weight: 700;
		box-shadow: 0 4px 16px rgb(0 0 0 / 20%);
		transition: transform 0.15s ease;
	}

	.skip-link:focus {
		transform: translateY(0);
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}
</style>

<!-- 站点初始化脚本 -->
<script>
import 'overlayscrollbars/overlayscrollbars.css';
import '../styles/animations.css';
import { initSite } from "../scripts/site-init";
import { setupSwupHooks } from "../scripts/swup-hooks";
import { setupFancybox } from "../scripts/fancybox-init";
import { setupScrollHandler } from "../scripts/scroll-handler";

// 站点初始化
initSite();

// Swup 钩子
if (window?.swup?.hooks) {
	setupSwupHooks();
} else {
	document.addEventListener('swup:enable', () => setupSwupHooks());
}

// Fancybox
if (window.swup) {
	setupFancybox();
} else {
	document.addEventListener("swup:enable", setupFancybox);
}

// 滚动处理
setupScrollHandler();
</script>
