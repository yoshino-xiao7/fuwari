---
import { Icon } from "astro-icon/components";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

interface Props {
	currentSlug: string;
	tags: string[];
	category?: string;
}

const { currentSlug, tags = [], category = "" } = Astro.props;
const tagSet = new Set(tags);

const posts = (await getSortedPosts())
	.filter((post) => post.slug !== currentSlug)
	.map((post) => {
		const tagScore = post.data.tags.filter((tag) => tagSet.has(tag)).length;
		const categoryScore = category && post.data.category === category ? 2 : 0;
		return {
			post,
			score: tagScore + categoryScore,
		};
	})
	.filter((item) => item.score > 0)
	.sort((a, b) => {
		if (a.score !== b.score) return b.score - a.score;
		return (
			new Date(b.post.data.published).getTime() -
			new Date(a.post.data.published).getTime()
		);
	})
	.slice(0, 3);
---

{posts.length > 0 && (
    <section class="mb-6 rounded-xl bg-[var(--license-block-bg)] p-4 onload-animation">
        <div class="mb-3 flex items-center gap-2">
            <div class="flex h-5 w-5 items-center justify-center rounded bg-[var(--primary)]">
                <Icon name="material-symbols:link-rounded" class="text-[0.85rem] text-white dark:text-black/70" />
            </div>
            <h2 class="text-sm font-bold text-black/80 dark:text-white/80">相关文章</h2>
        </div>
        <div class="grid gap-2 md:grid-cols-3">
            {posts.map(({ post }) => (
                <a
                    href={getPostUrlBySlug(post.slug)}
                    class="group rounded-lg bg-[var(--btn-regular-bg)] px-3 py-3 transition hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)]"
                >
                    <div class="line-clamp-2 text-sm font-bold leading-snug text-black/75 transition group-hover:text-[var(--primary)] dark:text-white/80">
                        {post.data.title}
                    </div>
                    <div class="mt-2 line-clamp-1 text-xs text-black/40 dark:text-white/40">
                        {post.data.category || post.data.tags.slice(0, 2).map((tag) => `#${tag}`).join(" ")}
                    </div>
                </a>
            ))}
        </div>
    </section>
)}
