---
/**
 * HeadMeta — <head> 中的 meta 标签、favicon、OG/Twitter 标签、RSS 链接
 * 从 Layout.astro 拆分而来
 */
import { profileConfig, siteConfig } from "@/config";
import { defaultFavicons } from "../../constants/icon";
import type { Favicon } from "../../types/config";
import {
	OG_IMAGE_HEIGHT,
	OG_IMAGE_WIDTH,
	getAbsoluteUrl,
	getCanonicalUrl,
} from "../../utils/seo-utils";
import { url } from "../../utils/url-utils";

interface Props {
	pageTitle: string;
	description: string;
	setOGTypeArticle?: boolean;
	ogImage?: string;
	ogImageAlt?: string;
	robots?: string;
	articlePublished?: Date;
	articleModified?: Date;
	articleSection?: string;
	articleTags?: string[];
}

const {
	pageTitle,
	description,
	setOGTypeArticle,
	ogImage,
	ogImageAlt,
	robots,
	articlePublished,
	articleModified,
	articleSection,
	articleTags = [],
} = Astro.props;

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
const keywords = siteConfig.keywords ?? [];

const canonicalUrl = getCanonicalUrl(Astro.url.pathname, Astro.site);
const fallbackOgImage =
	siteConfig.seo?.defaultOgImage ||
	profileConfig.avatar ||
	"/favicon/nodeseek.png";
const absoluteOgImage = getAbsoluteUrl(ogImage || fallbackOgImage, Astro.site);
// 只有经 resolveImageUrl 处理过的封面才确定是 1200x630；
// 回退图是 512x512 正方形，声明尺寸会与实际不符。
const hasProcessedOgImage = Boolean(ogImage);
---

<title>{pageTitle}</title>

<meta name="description" content={description}>
<meta name="author" content={profileConfig.name}>
{robots && <meta name="robots" content={robots}>}
{siteConfig.seo?.googleSiteVerification && (
	<meta name="google-site-verification" content={siteConfig.seo.googleSiteVerification}>
)}
{siteConfig.seo?.msValidate && (
	<meta name="msvalidate.01" content={siteConfig.seo.msValidate}>
)}
{keywords.length > 0 && (
	<meta name="keywords" content={keywords.join(", ")}>
)}
<link rel="canonical" href={canonicalUrl} />

<meta property="og:site_name" content={siteConfig.title}>
<meta property="og:locale" content={siteConfig.lang.replace("_", "-")}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:image" content={absoluteOgImage}>
{hasProcessedOgImage && (
	<>
		<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)}>
		<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)}>
	</>
)}
<meta property="og:image:alt" content={ogImageAlt || pageTitle}>
{setOGTypeArticle ? (
	<>
		<meta property="og:type" content="article" />
		{articlePublished && (
			<meta property="article:published_time" content={articlePublished.toISOString()}>
		)}
		{articleModified && (
			<meta property="article:modified_time" content={articleModified.toISOString()}>
		)}
		<meta property="article:author" content={profileConfig.name}>
		{articleSection && <meta property="article:section" content={articleSection}>}
		{articleTags.map((tag) => <meta property="article:tag" content={tag}>)}
	</>
) : (
	<meta property="og:type" content="website" />
)}

<meta name="twitter:card" content={hasProcessedOgImage ? "summary_large_image" : "summary"}>
<meta name="twitter:url" content={canonicalUrl}>
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={absoluteOgImage}>
<meta name="twitter:image:alt" content={ogImageAlt || pageTitle}>

<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

{favicons.map(favicon => (
	<link rel="icon"
		  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
		  sizes={favicon.sizes}
		  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
	/>
))}

<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>
