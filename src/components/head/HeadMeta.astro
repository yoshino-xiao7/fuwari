---
/**
 * HeadMeta — <head> 中的 meta 标签、favicon、OG/Twitter 标签、RSS 链接
 * 从 Layout.astro 拆分而来
 */
import { profileConfig, siteConfig } from "@/config";
import { defaultFavicons } from "../../constants/icon";
import type { Favicon } from "../../types/config";
import { getAbsoluteUrl, getCanonicalUrl } from "../../utils/seo-utils";
import { url } from "../../utils/url-utils";

interface Props {
	pageTitle: string;
	description: string;
	setOGTypeArticle?: boolean;
	ogImage?: string;
}

const { pageTitle, description, setOGTypeArticle, ogImage } = Astro.props;

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

const canonicalUrl = getCanonicalUrl(Astro.url.pathname, Astro.site);
const fallbackOgImage =
	siteConfig.seo?.defaultOgImage ||
	profileConfig.avatar ||
	"/favicon/nodeseek.png";
const absoluteOgImage = getAbsoluteUrl(ogImage || fallbackOgImage, Astro.site);
---

<title>{pageTitle}</title>

<meta charset="UTF-8" />
<meta name="description" content={description}>
<meta name="author" content={profileConfig.name}>
{siteConfig.keywords?.length > 0 && (
	<meta name="keywords" content={siteConfig.keywords.join(", ")}>
)}
<link rel="canonical" href={canonicalUrl} />

<meta property="og:site_name" content={siteConfig.title}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:image" content={absoluteOgImage}>
<meta property="og:image:alt" content={pageTitle}>
{setOGTypeArticle ? (
	<meta property="og:type" content="article" />
) : (
	<meta property="og:type" content="website" />
)}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content={canonicalUrl}>
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={absoluteOgImage}>
<meta name="twitter:image:alt" content={pageTitle}>

<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

{favicons.map(favicon => (
	<link rel="icon"
		  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
		  sizes={favicon.sizes}
		  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
	/>
))}

<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>
