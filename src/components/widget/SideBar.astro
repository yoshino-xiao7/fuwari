---
import type { MarkdownHeading } from "astro";

import Profile from "./Profile.astro";
// import Tag from "./Tags.astro"; // 已隐藏标签卡片
import DomainSwitcher from "./DomainSwitcher.astro";
import SetuCard from "./SetuCard.astro";
import MusicSearch from "./MusicSearch.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        <DomainSwitcher class="onload-animation" style="animation-delay: 150ms"></DomainSwitcher>
        <!-- 标签卡片已隐藏 -->
        <!-- <Tag class="onload-animation" style="animation-delay: 200ms"></Tag> -->
        <MusicSearch class="onload-animation" style="animation-delay: 200ms" />
	<SetuCard class="onload-animation" style="animation-delay: 250ms" />
    </div>
</div>
