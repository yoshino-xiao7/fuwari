---
import type { MarkdownHeading } from "astro";

import BlogExplorer from "./BlogExplorer.astro";
import Profile from "./Profile.astro";
import ProjectProgress from "./ProjectProgress.astro";
import YukiServices from "./YukiServices.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 sticky top-4 lg:max-h-[calc(100vh_-_2rem)] lg:overflow-y-auto lg:overscroll-contain lg:pr-1">
        <BlogExplorer class="onload-animation" style="animation-delay: 200ms" />
        <YukiServices class="onload-animation" style="animation-delay: 225ms" />
        <ProjectProgress class="onload-animation" style="animation-delay: 250ms" />
    </div>
</div>

<style>
    #sidebar-sticky {
        scrollbar-gutter: stable;
    }

    #sidebar-sticky::-webkit-scrollbar {
        width: 6px;
    }
</style>
