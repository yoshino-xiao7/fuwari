---
interface Props {
	class?: string;
	style?: string;
}

const className = Astro.props.class;
const style = Astro.props.style;
---

<!-- 侧边收缩状态 - 已由灵动岛取代，永久隐藏 -->
<div
  id="player-collapsed"
  class="!hidden fixed bottom-4 left-0 z-[100]"
>
  <button
    id="player-expand-from-side"
    type="button"
    class="player-lg-side-btn w-10 h-14 rounded-r-xl
           flex items-center justify-center
           hover:w-12 transition-all duration-300
           text-[oklch(0.65_0.2_var(--hue))]"
    aria-label="展开播放器"
  >
    <div class="player-lg-backdrop"></div>
    <div class="player-lg-border player-lg-border-screen"></div>
    <div class="player-lg-border player-lg-border-overlay"></div>
    <span class="relative z-10">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </span>
  </button>
  <!-- 播放状态指示器 -->
  <div id="collapsed-playing-indicator" class="hidden absolute -top-1 -right-1 w-3 h-3 bg-[oklch(0.65_0.2_var(--hue))] rounded-full animate-pulse"></div>
</div>

<!-- 全局音乐播放器 -->
<div
  id="global-music-player"
  class:list={[className, `
    fixed bottom-4 left-4 z-[100]
    transition-all duration-500 ease-out
    hidden
  `]}
  style={style}
>
  <div
    id="player-mini"
    class="hidden flex items-center gap-3 px-3 py-2 rounded-xl
           player-lg-container
           cursor-pointer hover:scale-105 transition-all duration-300
           animate-glow"
  >
    <div class="player-lg-backdrop"></div>
    <div class="player-lg-border player-lg-border-screen"></div>
    <div class="player-lg-border player-lg-border-overlay"></div>
    <div class="player-lg-hover-glow"></div>
    <img
      id="player-mini-cover"
      src=""
      alt=""
      class="w-10 h-10 rounded-full object-cover bg-neutral-200 dark:bg-neutral-600 cover-spin"
    />
    <div class="flex-1 min-w-0 max-w-32">
      <div id="player-mini-title" class="text-sm font-medium text-neutral-800 dark:text-neutral-200 truncate">
        未播放
      </div>
      <div id="player-mini-artist" class="text-xs text-neutral-500 truncate">
        --
      </div>
    </div>
    <div class="flex items-center gap-1">
      <button
        id="player-mini-toggle"
        type="button"
        class="w-9 h-9 rounded-full bg-[oklch(0.65_0.2_var(--hue))] 
               hover:bg-[oklch(0.55_0.25_var(--hue))] text-white
               flex items-center justify-center transition-colors"
        aria-label="播放/暂停"
      >
        <svg id="player-mini-play-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="player-mini-pause-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 4h4v16H6zM14 4h4v16h-4z"/>
        </svg>
      </button>
      <button
        id="player-expand-btn"
        type="button"
        class="w-8 h-8 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-700
               flex items-center justify-center transition-colors text-neutral-600 dark:text-neutral-400"
        aria-label="展开播放器"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 15l-6-6-6 6"/>
        </svg>
      </button>
      <!-- 收缩按钮已由灵动岛取代 -->
    </div>
  </div>

  <!-- 展开状态 -->
  <div
    id="player-full"
    class="w-80 rounded-2xl overflow-hidden
           player-lg-container"
  >
    <div class="player-lg-backdrop"></div>
    <div class="player-lg-border player-lg-border-screen"></div>
    <div class="player-lg-border player-lg-border-overlay"></div>
    <div class="player-lg-hover-glow"></div>
    <!-- 头部 -->
    <div class="relative">
      <!-- 封面背景 -->
      <div id="player-bg" class="absolute inset-0 bg-gradient-to-b from-[oklch(0.65_0.15_var(--hue))/30] to-transparent"></div>
      
      <div class="relative p-4 flex items-start gap-4">
        <img
          id="player-cover"
          src=""
          alt=""
          class="w-16 h-16 rounded-full object-cover shadow-lg bg-neutral-200 dark:bg-neutral-600 flex-shrink-0 cover-spin"
        />
        <div class="flex-1 min-w-0 pt-1">
          <div id="player-title" class="text-base font-semibold text-neutral-800 dark:text-neutral-100 truncate">
            未播放
          </div>
          <div id="player-artist" class="text-sm text-neutral-500 dark:text-neutral-400 truncate mt-0.5">
            --
          </div>
        </div>
        <!-- 收缩/最小化按钮已由灵动岛取代 -->
      </div>
    </div>

    <!-- 进度条 -->
    <div class="px-4 pb-2">
      <div class="relative group">
        <input
          type="range"
          id="player-progress"
          min="0"
          max="100"
          value="0"
          class="w-full h-1 bg-neutral-200 dark:bg-neutral-600 rounded-full appearance-none cursor-pointer
                 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-3 [&::-webkit-slider-thumb]:h-3
                 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-[oklch(0.65_0.2_var(--hue))]
                 [&::-webkit-slider-thumb]:shadow-md [&::-webkit-slider-thumb]:cursor-pointer
                 [&::-webkit-slider-thumb]:opacity-0 group-hover:[&::-webkit-slider-thumb]:opacity-100
                 [&::-webkit-slider-thumb]:transition-opacity"
        />
        <div
          id="player-progress-fill"
          class="absolute top-0 left-0 h-1 bg-[oklch(0.65_0.2_var(--hue))] rounded-full pointer-events-none"
          style="width: 0%"
        ></div>
      </div>
      <div class="flex justify-between text-xs text-neutral-500 mt-1">
        <span id="player-current-time">0:00</span>
        <span id="player-duration">0:00</span>
      </div>
    </div>

    <!-- 控制按钮 -->
    <div class="px-4 pb-3 flex items-center justify-center gap-4">
      <button
        id="player-prev"
        type="button"
        class="w-10 h-10 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-700
               flex items-center justify-center transition-colors text-neutral-600 dark:text-neutral-400"
        aria-label="上一首"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
        </svg>
      </button>
      <button
        id="player-toggle"
        type="button"
        class="w-14 h-14 rounded-full bg-[oklch(0.65_0.2_var(--hue))] 
               hover:bg-[oklch(0.55_0.25_var(--hue))] text-white
               flex items-center justify-center transition-all hover:scale-105 shadow-lg"
        aria-label="播放/暂停"
      >
        <svg id="player-play-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 ml-0.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="player-pause-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 4h4v16H6zM14 4h4v16h-4z"/>
        </svg>
      </button>
      <button
        id="player-next"
        type="button"
        class="w-10 h-10 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-700
               flex items-center justify-center transition-colors text-neutral-600 dark:text-neutral-400"
        aria-label="下一首"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
        </svg>
      </button>
    </div>

    <!-- 音量、音质和列表 -->
    <div class="px-4 pb-4 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <button
          id="player-mute"
          type="button"
          class="w-8 h-8 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-700
                 flex items-center justify-center transition-colors text-neutral-500"
          aria-label="静音"
        >
          <svg id="player-volume-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
          </svg>
          <svg id="player-mute-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
            <line x1="23" y1="9" x2="17" y2="15"/>
            <line x1="17" y1="9" x2="23" y2="15"/>
          </svg>
        </button>
        <input
          type="range"
          id="player-volume"
          min="0"
          max="100"
          value="80"
          class="w-16 h-1 bg-neutral-200 dark:bg-neutral-600 rounded-full appearance-none cursor-pointer
                 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-3 [&::-webkit-slider-thumb]:h-3
                 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-[oklch(0.65_0.2_var(--hue))]
                 [&::-webkit-slider-thumb]:cursor-pointer"
        />
      </div>
      
      <!-- 音质选择 -->
      <div class="quality-select-wrapper">
        <select
          id="player-quality"
          class="quality-select"
          aria-label="音质选择"
        >
          <option value="standard">标准</option>
          <option value="higher">较高</option>
          <option value="exhigh" selected>极高</option>
          <option value="lossless">无损</option>
          <option value="hires">Hi-Res</option>
        </select>
        <svg class="quality-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </div>
      
      <button
        id="player-list-toggle"
        type="button"
        class="w-8 h-8 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-700
               flex items-center justify-center transition-colors text-neutral-500"
        aria-label="播放列表"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="8" y1="6" x2="21" y2="6"/>
          <line x1="8" y1="12" x2="21" y2="12"/>
          <line x1="8" y1="18" x2="21" y2="18"/>
          <line x1="3" y1="6" x2="3.01" y2="6"/>
          <line x1="3" y1="12" x2="3.01" y2="12"/>
          <line x1="3" y1="18" x2="3.01" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- 播放列表 -->
    <div
      id="player-playlist"
      class="hidden border-t border-white/20 dark:border-white/8 max-h-48 overflow-y-auto"
    >
      <div class="p-2 text-xs text-neutral-500 font-medium px-4">播放列表</div>
      <div id="player-playlist-items" class="pb-2">
        <!-- 播放列表项目 -->
      </div>
    </div>
  </div>
</div>

<!-- 隐藏的音频元素 -->
<audio id="global-audio" preload="metadata"></audio>

<style>
  /* ===== Player Liquid Glass Container ===== */
  .player-lg-container {
    position: relative;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.35s ease;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.1),
      0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .player-lg-container:hover {
    box-shadow:
      0 12px 48px rgba(0, 0, 0, 0.15),
      0 4px 12px rgba(0, 0, 0, 0.08);
  }
  :global(.dark) .player-lg-container {
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.3),
      0 2px 8px rgba(0, 0, 0, 0.2);
  }
  :global(.dark) .player-lg-container:hover {
    box-shadow:
      0 12px 48px rgba(0, 0, 0, 0.4),
      0 4px 12px rgba(0, 0, 0, 0.25);
  }

  /* Content z-index above glass layers */
  .player-lg-container > *:not(.player-lg-backdrop):not(.player-lg-border):not(.player-lg-hover-glow) {
    position: relative;
    z-index: 5;
  }

  /* ===== Glass Backdrop Layer ===== */
  .player-lg-backdrop {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(20px) saturate(200%);
    -webkit-backdrop-filter: blur(20px) saturate(200%);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.5) 0%,
      rgba(255, 255, 255, 0.3) 50%,
      rgba(255, 255, 255, 0.4) 100%
    );
    z-index: 0;
  }
  :global(.dark) .player-lg-backdrop {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.04) 50%,
      rgba(255, 255, 255, 0.08) 100%
    );
  }

  /* ===== Gradient Border Layers ===== */
  .player-lg-border {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 3;
    padding: 1.5px;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    box-shadow:
      0 0 0 0.5px rgba(255, 255, 255, 0.4) inset,
      0 1px 3px rgba(255, 255, 255, 0.2) inset;
    transition: background 0.3s ease;
  }
  .player-lg-border-screen {
    mix-blend-mode: screen;
    opacity: 0.25;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.0) 0%,
      rgba(255, 255, 255, 0.15) 33%,
      rgba(255, 255, 255, 0.45) 66%,
      rgba(255, 255, 255, 0.0) 100%
    );
  }
  .player-lg-border-overlay {
    mix-blend-mode: overlay;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.0) 0%,
      rgba(255, 255, 255, 0.35) 33%,
      rgba(255, 255, 255, 0.65) 66%,
      rgba(255, 255, 255, 0.0) 100%
    );
  }

  /* ===== Hover Glow Layer ===== */
  .player-lg-hover-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    background-image: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 60%);
    mix-blend-mode: overlay;
    transition: opacity 0.35s ease;
  }
  .player-lg-container:hover .player-lg-hover-glow {
    opacity: 0.5;
  }

  /* ===== Side Button ===== */
  .player-lg-side-btn {
    position: relative;
    overflow: hidden;
    border: none;
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.1),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.4);
  }
  :global(.dark) .player-lg-side-btn {
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.3),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.1);
  }
  .player-lg-side-btn > .player-lg-backdrop {
    border-radius: inherit;
  }

  /* ===== Text readability ===== */
  .player-lg-container *,
  .player-lg-side-btn * {
    text-shadow: 0 0.5px 1px rgba(0, 0, 0, 0.04);
  }
  :global(.dark) .player-lg-container *,
  :global(.dark) .player-lg-side-btn * {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.25);
  }
  #player-playlist::-webkit-scrollbar {
    width: 4px;
  }
  #player-playlist::-webkit-scrollbar-track {
    background: transparent;
  }
  #player-playlist::-webkit-scrollbar-thumb {
    background: oklch(0.7 0.1 var(--hue));
    border-radius: 2px;
  }

  /* ===== Quality Selector ===== */
  .quality-select-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .quality-select {
    appearance: none;
    -webkit-appearance: none;
    height: 28px;
    padding: 0 26px 0 10px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    border-radius: 14px;
    background: linear-gradient(135deg, oklch(0.65 0.15 var(--hue) / 0.2), oklch(0.65 0.15 var(--hue) / 0.08));
    color: oklch(0.45 0.1 var(--hue));
    border: 1.5px solid oklch(0.65 0.15 var(--hue) / 0.3);
    cursor: pointer;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.25s ease;
    outline: none;
  }
  .quality-select:hover {
    background: linear-gradient(135deg, oklch(0.65 0.15 var(--hue) / 0.35), oklch(0.65 0.15 var(--hue) / 0.15));
    border-color: oklch(0.65 0.15 var(--hue) / 0.5);
    box-shadow: 0 2px 12px oklch(0.65 0.2 var(--hue) / 0.2);
  }
  .quality-select:focus {
    border-color: oklch(0.65 0.2 var(--hue) / 0.7);
    box-shadow: 0 0 0 3px oklch(0.65 0.2 var(--hue) / 0.15),
                0 2px 12px oklch(0.65 0.2 var(--hue) / 0.2);
  }
  .quality-select option {
    background: #fff;
    color: #333;
    font-weight: 500;
    padding: 4px 8px;
  }
  :global(.dark) .quality-select {
    background: linear-gradient(135deg, oklch(0.65 0.15 var(--hue) / 0.15), oklch(0.65 0.15 var(--hue) / 0.05));
    color: oklch(0.8 0.12 var(--hue));
    border-color: oklch(0.65 0.15 var(--hue) / 0.25);
  }
  :global(.dark) .quality-select:hover {
    background: linear-gradient(135deg, oklch(0.65 0.15 var(--hue) / 0.25), oklch(0.65 0.15 var(--hue) / 0.1));
    border-color: oklch(0.65 0.15 var(--hue) / 0.45);
  }
  :global(.dark) .quality-select option {
    background: #2a2a2a;
    color: #e0e0e0;
  }
  .quality-arrow {
    position: absolute;
    right: 7px;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    pointer-events: none;
    color: oklch(0.55 0.12 var(--hue));
    transition: color 0.2s ease;
  }
  :global(.dark) .quality-arrow {
    color: oklch(0.75 0.12 var(--hue));
  }
  
  /* 进度条动画 */
  #player-progress-fill {
    transition: width 0.2s linear;
  }
</style>

<script>
  // 根据环境自动选择 API 地址
  const isLocalhost = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
  const MUSIC_API = isLocalhost 
    ? "http://localhost:9898/blog/music" 
    : "https://api.yukiryou.icu/blog/music";

  interface Song {
    id: number | string;
    name: string;
    artist: string;
    cover: string;
    url?: string;
  }

  class GlobalMusicPlayer {
    private audio: HTMLAudioElement | null = null;
    private playlist: Song[] = [];
    private currentIndex: number = -1;
    private isPlaying: boolean = false;
    private isMinimized: boolean = false;
    private isCollapsed: boolean = false;
    private volume: number = 0.8;

    // 元素
    private playerEl: HTMLElement | null = null;
    private miniEl: HTMLElement | null = null;
    private fullEl: HTMLElement | null = null;
    private collapsedEl: HTMLElement | null = null;

    constructor() {
      this.init();
    }

    private init() {
      this.audio = document.getElementById("global-audio") as HTMLAudioElement;
      this.playerEl = document.getElementById("global-music-player");
      this.miniEl = document.getElementById("player-mini");
      this.fullEl = document.getElementById("player-full");
      this.collapsedEl = document.getElementById("player-collapsed");

      if (!this.audio || !this.playerEl) return;

      this.loadState();
      this.bindEvents();
      this.bindAudioEvents();

      // 如果有播放列表，只恢复播放器数据。
      // 可见状态和位置统一交给灵动岛管理，避免刷新后播放器按旧的左下角布局自行显示。
      if (this.playlist.length > 0) {
        this.updateUI();
        this.hideShellForDynamicIsland();
      }
    }

    private loadState() {
      try {
        const savedPlaylist = localStorage.getItem("music_playlist");
        const savedIndex = localStorage.getItem("music_current_index");
        const savedVolume = localStorage.getItem("music_volume");
        const savedQuality = localStorage.getItem("music_quality");

        if (savedPlaylist) this.playlist = JSON.parse(savedPlaylist);
        if (savedIndex) this.currentIndex = parseInt(savedIndex, 10);
        if (savedVolume) this.volume = parseFloat(savedVolume);
        
        // 可见状态已由灵动岛取代，清除旧版播放器自身的显示状态缓存。
        localStorage.removeItem("music_is_minimized");
        localStorage.removeItem("music_is_collapsed");
        this.isMinimized = false;
        this.isCollapsed = false;
        
        // 加载音质设置
        if (savedQuality) {
          const qualitySelect = document.getElementById("player-quality") as HTMLSelectElement;
          if (qualitySelect) qualitySelect.value = savedQuality;
        }

        if (this.audio) this.audio.volume = this.volume;
      } catch (e) {
        console.error("加载播放器状态失败", e);
      }
    }

    private saveState() {
      try {
        localStorage.setItem("music_playlist", JSON.stringify(this.playlist));
        localStorage.setItem("music_current_index", String(this.currentIndex));
        localStorage.setItem("music_volume", String(this.volume));
      } catch (e) {
        console.error("保存播放器状态失败", e);
      }
    }

    private hideShellForDynamicIsland() {
      if (!this.playerEl) return;

      this.playerEl.style.cssText = "";
      this.playerEl.classList.add("hidden");
      this.playerEl.classList.remove("pl-4", "animate-slide-up", "animate-collapse-out");
      this.collapsedEl?.classList.add("hidden");
      this.collapsedEl?.classList.remove("animate-arrow-in", "animate-arrow-out");
      this.miniEl?.classList.add("hidden");
      this.fullEl?.classList.remove("hidden");
    }

    private bindEvents() {
      // 监听添加歌曲事件（点击+号按钮，添加并自动播放）
      window.addEventListener("music:add", ((e: CustomEvent) => {
        this.addSong(e.detail, true);
      }) as EventListener);

      // 监听播放歌曲事件（点击歌曲项，添加并播放）
      window.addEventListener("music:play", ((e: CustomEvent) => {
        this.addSong(e.detail, true);
      }) as EventListener);

      // 播放/暂停
      document.getElementById("player-toggle")?.addEventListener("click", () => this.togglePlay());
      document.getElementById("player-mini-toggle")?.addEventListener("click", (e) => {
        e.stopPropagation();
        this.togglePlay();
      });

      // 上一首/下一首
      document.getElementById("player-prev")?.addEventListener("click", () => this.playPrev());
      document.getElementById("player-next")?.addEventListener("click", () => this.playNext());

      // 最小化/展开
      document.getElementById("player-minimize-btn")?.addEventListener("click", () => this.minimize());
      document.getElementById("player-expand-btn")?.addEventListener("click", (e) => {
        e.stopPropagation();
        this.expand();
      });
      this.miniEl?.addEventListener("click", () => this.expand());

      // 收缩到侧边
      document.getElementById("player-collapse-side-mini")?.addEventListener("click", (e) => {
        e.stopPropagation();
        this.collapse();
      });
      document.getElementById("player-collapse-side-full")?.addEventListener("click", () => this.collapse());
      
      // 从侧边展开
      document.getElementById("player-expand-from-side")?.addEventListener("click", () => this.expandFromSide());

      // 进度条
      const progressInput = document.getElementById("player-progress") as HTMLInputElement;
      progressInput?.addEventListener("input", () => {
        if (this.audio && this.audio.duration) {
          const percent = parseFloat(progressInput.value);
          this.audio.currentTime = (percent / 100) * this.audio.duration;
        }
      });

      // 音量
      const volumeInput = document.getElementById("player-volume") as HTMLInputElement;
      volumeInput?.addEventListener("input", () => {
        this.volume = parseFloat(volumeInput.value) / 100;
        if (this.audio) this.audio.volume = this.volume;
        this.updateVolumeIcon();
        this.saveState();
      });

      // 静音
      document.getElementById("player-mute")?.addEventListener("click", () => this.toggleMute());

      // 播放列表切换
      document.getElementById("player-list-toggle")?.addEventListener("click", () => {
        const playlistEl = document.getElementById("player-playlist");
        playlistEl?.classList.toggle("hidden");
      });

      // 音质选择 - 切换后立即重新加载当前歌曲
      const qualitySelect = document.getElementById("player-quality") as HTMLSelectElement;
      qualitySelect?.addEventListener("change", () => {
        localStorage.setItem("music_quality", qualitySelect.value);
        // 如果当前有歌曲在播放，重新加载以应用新音质
        if (this.currentIndex >= 0 && this.audio) {
          const currentTime = this.audio.currentTime;
          const wasPlaying = this.isPlaying;
          this.playCurrent().then(() => {
            // 恢复播放进度
            if (this.audio && currentTime > 0) {
              this.audio.currentTime = currentTime;
            }
            // 如果之前没在播放，暂停
            if (!wasPlaying && this.audio) {
              this.audio.pause();
            }
          });
        }
      });
    }

    private bindAudioEvents() {
      if (!this.audio) return;

      this.audio.addEventListener("timeupdate", () => this.updateProgress());
      this.audio.addEventListener("loadedmetadata", () => this.updateDuration());
      this.audio.addEventListener("ended", () => this.playNext());
      this.audio.addEventListener("play", () => {
        this.isPlaying = true;
        this.updatePlayIcon();
      });
      this.audio.addEventListener("pause", () => {
        this.isPlaying = false;
        this.updatePlayIcon();
      });
      this.audio.addEventListener("error", () => {
        console.error("音频加载失败");
        // 尝试播放下一首
        if (this.playlist.length > 1) {
          this.playNext();
        }
      });
    }

    private collapse() {
      this.isCollapsed = true;
      
      // 添加退出动画
      this.playerEl?.classList.add("animate-collapse-out");
      
      // 动画结束后隐藏播放器，显示箭头
      setTimeout(() => {
        this.playerEl?.classList.add("hidden");
        this.playerEl?.classList.remove("animate-collapse-out");
        this.collapsedEl?.classList.remove("hidden");
        this.collapsedEl?.classList.add("animate-arrow-in");
        
        // 清理箭头动画类
        setTimeout(() => {
          this.collapsedEl?.classList.remove("animate-arrow-in");
        }, 300);
      }, 400);
      
      this.updateCollapsedIndicator();
      this.saveState();
    }

    private expandFromSide() {
      this.isCollapsed = false;
      
      // 箭头退出动画
      this.collapsedEl?.classList.add("animate-arrow-out");
      
      // 动画结束后隐藏箭头，显示播放器
      setTimeout(() => {
        this.collapsedEl?.classList.add("hidden");
        this.collapsedEl?.classList.remove("animate-arrow-out");
        
        // 先设置播放器初始位置在左侧屏幕外
        if (this.playerEl) {
          this.playerEl.style.transform = "translateX(-100%)";
          this.playerEl.style.opacity = "0";
        }
        
        this.playerEl?.classList.remove("hidden");
        this.playerEl?.classList.add("pl-4");
        
        // 根据状态显示 mini 或 full
        if (this.isMinimized) {
          this.miniEl?.classList.remove("hidden");
          this.fullEl?.classList.add("hidden");
        } else {
          this.miniEl?.classList.add("hidden");
          this.fullEl?.classList.remove("hidden");
        }
        
        // 使用 requestAnimationFrame 确保 DOM 更新后再开始动画
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            if (this.playerEl) {
              this.playerEl.style.transition = "transform 0.4s ease-out, opacity 0.4s ease-out";
              this.playerEl.style.transform = "translateX(0)";
              this.playerEl.style.opacity = "1";
            }
            
            // 清理样式
            setTimeout(() => {
              if (this.playerEl) {
                this.playerEl.style.transition = "";
                this.playerEl.style.transform = "";
                this.playerEl.style.opacity = "";
              }
            }, 400);
          });
        });
      }, 300);
      
      this.saveState();
    }

    private updateCollapsedIndicator() {
      const indicator = document.getElementById("collapsed-playing-indicator");
      if (this.isPlaying) {
        indicator?.classList.remove("hidden");
      } else {
        indicator?.classList.add("hidden");
      }
    }

    private minimize() {
      this.isMinimized = true;
      
      // 立即隐藏 full
      this.fullEl?.classList.add("hidden");
      
      // 设置 mini 初始状态
      if (this.miniEl) {
        this.miniEl.style.opacity = "0";
        this.miniEl.style.transform = "translateY(10px)";
      }
      this.miniEl?.classList.remove("hidden");
      
      // 动画显示 mini
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (this.miniEl) {
            this.miniEl.style.transition = "opacity 0.25s ease-out, transform 0.25s ease-out";
            this.miniEl.style.opacity = "1";
            this.miniEl.style.transform = "translateY(0)";
          }
          
          setTimeout(() => {
            if (this.miniEl) {
              this.miniEl.style.transition = "";
              this.miniEl.style.opacity = "";
              this.miniEl.style.transform = "";
            }
          }, 250);
        });
      });
      
      this.saveState();
    }

    private expand() {
      this.isMinimized = false;
      
      // 立即隐藏 mini
      this.miniEl?.classList.add("hidden");
      
      // 设置 full 初始状态
      if (this.fullEl) {
        this.fullEl.style.opacity = "0";
        this.fullEl.style.transform = "translateY(-10px)";
      }
      this.fullEl?.classList.remove("hidden");
      
      // 动画显示 full
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (this.fullEl) {
            this.fullEl.style.transition = "opacity 0.25s ease-out, transform 0.25s ease-out";
            this.fullEl.style.opacity = "1";
            this.fullEl.style.transform = "translateY(0)";
          }
          
          setTimeout(() => {
            if (this.fullEl) {
              this.fullEl.style.transition = "";
              this.fullEl.style.opacity = "";
              this.fullEl.style.transform = "";
            }
          }, 250);
        });
      });
      
      this.saveState();
    }

    private addSong(song: Song, autoPlay: boolean = true) {
      // 检查是否已存在
      const existingIndex = this.playlist.findIndex((s) => s.id === song.id);
      if (existingIndex === -1) {
        this.playlist.push(song);
        this.saveState();
        this.updatePlaylist();
        // 新添加的歌曲，自动播放它
        if (autoPlay) {
          this.currentIndex = this.playlist.length - 1;
          this.playCurrent();
        }
      } else if (autoPlay) {
        // 歌曲已存在，直接播放它
        this.currentIndex = existingIndex;
        this.playCurrent();
      }
    }

    private async playCurrent() {
      if (this.currentIndex < 0 || this.currentIndex >= this.playlist.length) return;

      const song = this.playlist[this.currentIndex];
      this.updateUI();

      try {
        // 获取选中的音质
        const qualitySelect = document.getElementById("player-quality") as HTMLSelectElement;
        const quality = qualitySelect?.value || "exhigh";
        
        // 获取播放地址
        const res = await fetch(`${MUSIC_API}/url?id=${song.id}&level=${quality}`);
        if (!res.ok) throw new Error("获取播放地址失败");

        const json = await res.json();
        let url = json.data?.[0]?.url;

        if (!url) throw new Error("歌曲无法播放");

        // 优先使用 HTTPS（解决混合内容问题）
        const httpsUrl = url.replace(/^http:\/\//, 'https://');
        const httpUrl = url; // 保留原始 HTTP 地址作为降级备选
        
        song.url = httpsUrl;
        if (this.audio) {
          // 先尝试 HTTPS
          this.audio.src = httpsUrl;
          
          // 监听加载错误，自动降级到 HTTP
          const handleError = () => {
            console.warn("HTTPS 播放失败，降级到 HTTP");
            if (this.audio && httpsUrl !== httpUrl) {
              this.audio.removeEventListener("error", handleError);
              this.audio.src = httpUrl;
              song.url = httpUrl;
              this.audio.play().catch(() => {
                console.error("HTTP 播放也失败了");
              });
            }
          };
          
          // 一次性错误监听器
          this.audio.addEventListener("error", handleError, { once: true });
          
          this.audio.play().catch(() => {
            // play() 失败会触发上面的 error 事件处理
          });
        }
        this.saveState();
      } catch (e) {
        console.error("播放失败", e);
      }
    }

    private togglePlay() {
      if (!this.audio) return;

      if (this.isPlaying) {
        this.audio.pause();
      } else {
        if (this.currentIndex === -1 && this.playlist.length > 0) {
          this.currentIndex = 0;
          this.playCurrent();
        } else if (this.audio.src) {
          this.audio.play();
        } else if (this.currentIndex >= 0) {
          this.playCurrent();
        }
      }
    }

    private playPrev() {
      if (this.playlist.length === 0) return;
      this.currentIndex = (this.currentIndex - 1 + this.playlist.length) % this.playlist.length;
      this.playCurrent();
    }

    private playNext() {
      if (this.playlist.length === 0) return;
      this.currentIndex = (this.currentIndex + 1) % this.playlist.length;
      this.playCurrent();
    }

    private toggleMute() {
      if (!this.audio) return;
      this.audio.muted = !this.audio.muted;
      this.updateVolumeIcon();
    }

    private updateUI() {
      const song = this.playlist[this.currentIndex];
      if (!song) return;

      // 更新封面
      const coverEl = document.getElementById("player-cover") as HTMLImageElement;
      const miniCoverEl = document.getElementById("player-mini-cover") as HTMLImageElement;
      const coverUrl = song.cover ? `${song.cover}?param=120y120` : "";
      
      if (coverEl) coverEl.src = coverUrl;
      if (miniCoverEl) miniCoverEl.src = coverUrl;

      // 更新标题
      const titleEl = document.getElementById("player-title");
      const miniTitleEl = document.getElementById("player-mini-title");
      if (titleEl) titleEl.textContent = song.name;
      if (miniTitleEl) miniTitleEl.textContent = song.name;

      // 更新歌手
      const artistEl = document.getElementById("player-artist");
      const miniArtistEl = document.getElementById("player-mini-artist");
      if (artistEl) artistEl.textContent = song.artist;
      if (miniArtistEl) miniArtistEl.textContent = song.artist;

      this.updatePlaylist();

      // Dispatch event for Dynamic Island sync
      window.dispatchEvent(new CustomEvent("music:songChange", {
        detail: { id: song.id, name: song.name, artist: song.artist, cover: coverUrl }
      }));
    }

    private updatePlaylist() {
      const container = document.getElementById("player-playlist-items");
      if (!container) return;

      container.innerHTML = "";

      this.playlist.forEach((song, index) => {
        const item = document.createElement("div");
        item.className = `
          flex items-center gap-3 px-4 py-2 cursor-pointer
          ${index === this.currentIndex ? "bg-[oklch(0.65_0.2_var(--hue))/10]" : ""}
          hover:bg-neutral-100 dark:hover:bg-neutral-700/50 transition-colors
        `;

        item.innerHTML = `
          <img src="${song.cover}?param=40y40" class="w-8 h-8 rounded object-cover" alt="" />
          <div class="flex-1 min-w-0">
            <div class="text-sm truncate ${index === this.currentIndex ? "text-[oklch(0.65_0.2_var(--hue))]" : "text-neutral-700 dark:text-neutral-300"}">${song.name}</div>
            <div class="text-xs text-neutral-500 truncate">${song.artist}</div>
          </div>
          <button class="remove-song-btn w-6 h-6 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-600 
                         flex items-center justify-center text-neutral-400 hover:text-red-500 transition-colors" 
                  data-index="${index}">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        `;

        item.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest(".remove-song-btn")) return;
          this.currentIndex = index;
          this.playCurrent();
        });

        const removeBtn = item.querySelector(".remove-song-btn");
        removeBtn?.addEventListener("click", (e) => {
          e.stopPropagation();
          this.removeSong(index);
        });

        container.appendChild(item);
      });
    }

    private removeSong(index: number) {
      if (index === this.currentIndex) {
        this.audio?.pause();
        if (this.playlist.length > 1) {
          this.playlist.splice(index, 1);
          this.currentIndex = Math.min(index, this.playlist.length - 1);
          this.playCurrent();
        } else {
          this.playlist.splice(index, 1);
          this.currentIndex = -1;
          this.playerEl?.classList.add("hidden");
        }
      } else {
        this.playlist.splice(index, 1);
        if (index < this.currentIndex) {
          this.currentIndex--;
        }
      }
      this.saveState();
      this.updatePlaylist();
    }

    private updateProgress() {
      if (!this.audio) return;

      const current = this.audio.currentTime;
      const duration = this.audio.duration || 0;
      const percent = duration ? (current / duration) * 100 : 0;

      const progressInput = document.getElementById("player-progress") as HTMLInputElement;
      const progressFill = document.getElementById("player-progress-fill");
      const currentTimeEl = document.getElementById("player-current-time");

      if (progressInput) progressInput.value = String(percent);
      if (progressFill) progressFill.style.width = `${percent}%`;
      if (currentTimeEl) currentTimeEl.textContent = this.formatTime(current);
    }

    private updateDuration() {
      const durationEl = document.getElementById("player-duration");
      if (durationEl && this.audio) {
        durationEl.textContent = this.formatTime(this.audio.duration);
      }
    }

    private updatePlayIcon() {
      const playIcon = document.getElementById("player-play-icon");
      const pauseIcon = document.getElementById("player-pause-icon");
      const miniPlayIcon = document.getElementById("player-mini-play-icon");
      const miniPauseIcon = document.getElementById("player-mini-pause-icon");
      
      // 动画相关元素
      const coverEl = document.getElementById("player-cover");
      const miniCoverEl = document.getElementById("player-mini-cover");
      const playerToggle = document.getElementById("player-toggle");
      const playerFull = document.getElementById("player-full");
      const playerMini = document.getElementById("player-mini");

      if (this.isPlaying) {
        playIcon?.classList.add("hidden");
        pauseIcon?.classList.remove("hidden");
        miniPlayIcon?.classList.add("hidden");
        miniPauseIcon?.classList.remove("hidden");
        
        // 启用播放动画
        coverEl?.classList.add("playing");
        miniCoverEl?.classList.add("playing");
        playerToggle?.classList.add("playing");
        playerFull?.classList.add("playing");
        playerMini?.classList.add("playing");
      } else {
        playIcon?.classList.remove("hidden");
        pauseIcon?.classList.add("hidden");
        miniPlayIcon?.classList.remove("hidden");
        miniPauseIcon?.classList.add("hidden");
        
        // 暂停动画
        coverEl?.classList.remove("playing");
        miniCoverEl?.classList.remove("playing");
        playerToggle?.classList.remove("playing");
        playerFull?.classList.remove("playing");
        playerMini?.classList.remove("playing");
      }
      
      // 更新收缩状态指示器
      this.updateCollapsedIndicator();
    }

    private updateVolumeIcon() {
      const volumeIcon = document.getElementById("player-volume-icon");
      const muteIcon = document.getElementById("player-mute-icon");
      const isMuted = this.audio?.muted || this.volume === 0;

      if (isMuted) {
        volumeIcon?.classList.add("hidden");
        muteIcon?.classList.remove("hidden");
      } else {
        volumeIcon?.classList.remove("hidden");
        muteIcon?.classList.add("hidden");
      }
    }

    private formatTime(seconds: number): string {
      if (!seconds || isNaN(seconds)) return "0:00";
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs.toString().padStart(2, "0")}`;
    }
  }

  // 初始化播放器
  new GlobalMusicPlayer();
</script>
