---
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
  style?: string;
}

const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout name="🎵 音乐搜索" id="music-search" class={className} style={style}>
  <div class="flex flex-col gap-3 text-sm">
    <!-- 搜索框 -->
    <div class="flex gap-2">
      <input
        id="music-search-input"
        type="text"
        placeholder="输入歌曲名或歌手..."
        class="flex-1 h-9 px-3 rounded-lg bg-neutral-100 dark:bg-neutral-700 
               text-neutral-800 dark:text-neutral-200 text-sm
               border border-neutral-200 dark:border-neutral-600
               focus:outline-none focus:ring-2 focus:ring-[oklch(0.65_0.2_var(--hue))]
               placeholder:text-neutral-400"
      />
      <button
        id="music-search-btn"
        type="button"
        aria-label="搜索音乐"
        class="btn-regular h-9 px-4 rounded-lg inline-flex items-center justify-center flex-shrink-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="M21 21l-4.35-4.35"></path>
        </svg>
      </button>
    </div>

    <!-- 搜索状态 -->
    <p id="music-search-status" class="text-xs text-neutral-500 hidden"></p>

    <!-- 搜索结果头部（可收缩） -->
    <div id="music-results-header" class="hidden flex items-center justify-between">
      <button
        id="music-results-toggle"
        type="button"
        class="flex items-center gap-2 text-xs text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors"
      >
        <svg id="results-chevron" xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9l6 6 6-6"/>
        </svg>
        <span id="music-results-count">找到 0 首歌曲</span>
      </button>
      <button
        id="music-results-clear"
        type="button"
        class="text-xs text-neutral-400 hover:text-red-500 transition-colors"
        aria-label="清除搜索结果"
      >
        清除
      </button>
    </div>

    <!-- 搜索结果（可收缩） -->
    <div id="music-search-results" class="flex flex-col gap-2 max-h-64 overflow-y-auto hidden transition-all duration-300">
      <!-- 动态填充搜索结果 -->
    </div>

    <!-- 错误信息 -->
    <p id="music-search-error" class="text-xs text-red-500 hidden"></p>
  </div>
</WidgetLayout>

<style>
  #music-search-results::-webkit-scrollbar {
    width: 4px;
  }
  #music-search-results::-webkit-scrollbar-track {
    background: transparent;
  }
  #music-search-results::-webkit-scrollbar-thumb {
    background: oklch(0.7 0.1 var(--hue));
    border-radius: 2px;
  }
  
  /* 收缩状态 */
  #music-search-results.collapsed {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
  }
  
  #results-chevron.collapsed {
    transform: rotate(-90deg);
  }
</style>

<script>
  // 根据环境自动选择 API 地址
  const isLocalhost = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
  const MUSIC_API = isLocalhost 
    ? "http://localhost:9898/blog/music" 
    : "https://api.yukiryou.icu/blog/music";

  (function () {
    const root = document.getElementById("music-search");
    if (!root) return;

    const searchInput = root.querySelector("#music-search-input") as HTMLInputElement;
    const searchBtn = root.querySelector("#music-search-btn");
    const resultsContainer = root.querySelector("#music-search-results");
    const resultsHeader = root.querySelector("#music-results-header");
    const resultsToggle = root.querySelector("#music-results-toggle");
    const resultsCount = root.querySelector("#music-results-count");
    const resultsClear = root.querySelector("#music-results-clear");
    const resultsChevron = root.querySelector("#results-chevron");
    const statusEl = root.querySelector("#music-search-status");
    const errorEl = root.querySelector("#music-search-error");

    let searching = false;
    let isCollapsed = false;

    function showStatus(text: string) {
      if (statusEl) {
        statusEl.textContent = text;
        statusEl.classList.remove("hidden");
      }
    }

    function hideStatus() {
      if (statusEl) {
        statusEl.classList.add("hidden");
      }
    }

    function showError(text: string) {
      if (errorEl) {
        errorEl.textContent = text;
        errorEl.classList.remove("hidden");
      }
    }

    function hideError() {
      if (errorEl) {
        errorEl.classList.add("hidden");
      }
    }

    function toggleResults() {
      isCollapsed = !isCollapsed;
      if (isCollapsed) {
        resultsContainer?.classList.add("collapsed");
        resultsChevron?.classList.add("collapsed");
      } else {
        resultsContainer?.classList.remove("collapsed");
        resultsChevron?.classList.remove("collapsed");
      }
    }

    function clearResults() {
      if (resultsContainer) {
        resultsContainer.innerHTML = "";
        resultsContainer.classList.add("hidden");
      }
      resultsHeader?.classList.add("hidden");
      if (searchInput) searchInput.value = "";
      hideStatus();
      hideError();
      isCollapsed = false;
      resultsContainer?.classList.remove("collapsed");
      resultsChevron?.classList.remove("collapsed");
    }

    function renderResults(songs: any[]) {
      if (!resultsContainer) return;
      
      resultsContainer.innerHTML = "";
      
      if (songs.length === 0) {
        showStatus("没有找到相关歌曲");
        resultsContainer.classList.add("hidden");
        resultsHeader?.classList.add("hidden");
        return;
      }

      // 更新结果计数
      if (resultsCount) {
        resultsCount.textContent = `找到 ${songs.length} 首歌曲`;
      }
      resultsHeader?.classList.remove("hidden");

      songs.forEach((song) => {
        const item = document.createElement("div");
        item.className = `
          flex items-center gap-3 p-2 rounded-lg cursor-pointer
          bg-neutral-50 dark:bg-neutral-700/50
          hover:bg-neutral-100 dark:hover:bg-neutral-700
          transition-colors duration-200
        `;

        const cover = song.al?.picUrl || "";
        const name = song.name || "未知歌曲";
        const artist = song.ar?.map((a: any) => a.name).join(" / ") || "未知歌手";
        const id = song.id;

        item.innerHTML = `
          <img 
            src="${cover}?param=60y60" 
            alt="${name}"
            class="w-10 h-10 rounded-md object-cover flex-shrink-0 bg-neutral-200 dark:bg-neutral-600"
            loading="lazy"
            onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 40 40%22><rect fill=%22%23666%22 width=%2240%22 height=%2240%22/><text x=%2220%22 y=%2225%22 text-anchor=%22middle%22 fill=%22%23999%22 font-size=%2214%22>🎵</text></svg>'"
          />
          <div class="flex-1 min-w-0">
            <div class="text-sm font-medium text-neutral-800 dark:text-neutral-200 truncate">${name}</div>
            <div class="text-xs text-neutral-500 truncate">${artist}</div>
          </div>
          <button 
            type="button"
            class="music-add-btn flex-shrink-0 w-8 h-8 rounded-full 
                   bg-[oklch(0.65_0.2_var(--hue))] hover:bg-[oklch(0.55_0.25_var(--hue))]
                   text-white flex items-center justify-center transition-colors"
            aria-label="添加到播放列表"
            data-song-id="${id}"
            data-song-name="${name}"
            data-song-artist="${artist}"
            data-song-cover="${cover}"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M5 12h14"></path>
            </svg>
          </button>
        `;

        // 点击歌曲项直接播放
        item.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          if (target.closest(".music-add-btn")) return; // 排除点击添加按钮
          
          const songData = {
            id,
            name,
            artist,
            cover
          };
          window.dispatchEvent(new CustomEvent("music:play", { detail: songData }));
        });

        // 点击添加按钮添加到列表
        const addBtn = item.querySelector(".music-add-btn");
        addBtn?.addEventListener("click", () => {
          const songData = {
            id,
            name,
            artist,
            cover
          };
          window.dispatchEvent(new CustomEvent("music:add", { detail: songData }));
        });

        resultsContainer.appendChild(item);
      });

      resultsContainer.classList.remove("hidden", "collapsed");
      resultsChevron?.classList.remove("collapsed");
      isCollapsed = false;
      hideStatus();
    }

    async function doSearch() {
      if (searching) return;
      
      const keyword = searchInput?.value.trim();
      if (!keyword) {
        showError("请输入搜索关键词");
        return;
      }

      searching = true;
      hideError();
      showStatus("正在搜索...");

      try {
        const res = await fetch(`${MUSIC_API}/search?keywords=${encodeURIComponent(keyword)}&limit=10`);
        if (!res.ok) throw new Error("搜索失败：" + res.status);

        const json = await res.json();
        const songs = json.result?.songs || [];
        renderResults(songs);
      } catch (e) {
        showError(e instanceof Error ? e.message : "搜索失败，请稍后重试");
        if (resultsContainer) resultsContainer.classList.add("hidden");
        resultsHeader?.classList.add("hidden");
      } finally {
        searching = false;
      }
    }

    // 点击搜索按钮
    searchBtn?.addEventListener("click", doSearch);

    // 回车搜索
    searchInput?.addEventListener("keypress", (e) => {
      if (e.key === "Enter") {
        doSearch();
      }
    });

    // 收缩/展开结果
    resultsToggle?.addEventListener("click", toggleResults);

    // 清除结果
    resultsClear?.addEventListener("click", clearResults);
  })();
</script>
