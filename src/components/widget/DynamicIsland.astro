---
/**
 * Dynamic Island — Apple-style pill in the navbar center
 * Acts as a thin controller that repositions and shows the
 * existing GlobalMusicPlayer (#player-full) below the island.
 * All features (volume, quality, playlist, etc.) are preserved.
 */
---

<div id="dynamic-island" class="dynamic-island di-idle" title="音乐播放器">
  <!-- Idle: music note -->
  <div id="di-idle" class="di-pill-idle">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white/60" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55C7.79 13 6 14.79 6 17s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
    </svg>
  </div>
  <!-- Playing: cover + lyric + waveform -->
  <div id="di-playing" class="di-pill-playing hidden">
    <img id="di-cover" src="" alt="" class="di-cover cover-spin" />
    <div id="di-lyric" class="di-lyric">♪ 播放中</div>
    <div class="di-waveform" id="di-waveform">
      <span></span><span></span><span></span><span></span>
    </div>
  </div>
</div>

<!-- Backdrop for click-away -->
<div id="di-backdrop" class="di-backdrop hidden"></div>

<style>
  /* ===== Island pill ===== */
  .dynamic-island {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
    border-radius: 99px;
    cursor: pointer;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
    z-index: 100;
    overflow: hidden;
    flex-shrink: 0;
    transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.3s ease;
  }
  .dynamic-island:hover {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
  }

  /* Idle */
  .dynamic-island.di-idle {
    width: 110px;
    height: 32px;
    padding: 0 14px;
  }

  /* Playing */
  .dynamic-island.di-playing-pill {
    width: 180px;
    height: 34px;
    padding: 0 10px;
  }

  /* Inner states */
  .di-pill-idle, .di-pill-playing {
    display: flex;
    align-items: center;
    width: 100%;
  }
  .di-pill-idle { justify-content: center; }
  .di-pill-playing { gap: 8px; }

  /* Cover */
  .di-cover {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    background: #333;
    flex-shrink: 0;
  }

  /* Lyric */
  .di-lyric {
    flex: 1;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.85);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    transition: opacity 0.15s ease;
  }

  /* Waveform — only .active animates */
  .di-waveform {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 16px;
    flex-shrink: 0;
  }
  .di-waveform span {
    display: block;
    width: 2px;
    background: oklch(0.7 0.18 var(--hue));
    border-radius: 1px;
    height: 4px;
    transition: height 0.2s ease;
  }
  .di-waveform.active span {
    animation: diWave 1.2s ease-in-out infinite;
  }
  .di-waveform.active span:nth-child(1) { animation-delay: 0s; }
  .di-waveform.active span:nth-child(2) { animation-delay: 0.2s; }
  .di-waveform.active span:nth-child(3) { animation-delay: 0.4s; }
  .di-waveform.active span:nth-child(4) { animation-delay: 0.6s; }
  @keyframes diWave {
    0%, 100% { height: 4px; }
    50% { height: 14px; }
  }

  /* Backdrop */
  .di-backdrop {
    position: fixed;
    inset: 0;
    z-index: 95;
    background: rgba(0,0,0,0.15);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    transition: opacity 0.3s ease;
  }

  /* Cover spin */
  .cover-spin {
    animation: spin 12s linear infinite;
    animation-play-state: paused;
  }
  .cover-spin.playing { animation-play-state: running; }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .dynamic-island.di-playing-pill { width: 150px; }
  }
</style>

<script>
class DynamicIsland {
  private island: HTMLElement | null = null;
  private backdropEl: HTMLElement | null = null;
  private audio: HTMLAudioElement | null = null;
  private isExpanded = false;
  private lyrics: Array<{time: number, text: string}> = [];
  private currentLyricIndex = -1;
  private hasSong = false;

  constructor() { this.init(); }

  private init() {
    this.island = document.getElementById("dynamic-island");
    this.backdropEl = document.getElementById("di-backdrop");
    this.audio = document.getElementById("global-audio") as HTMLAudioElement;
    if (!this.island) return;
    this.bindEvents();
    this.syncWithPlayer();
  }

  private bindEvents() {
    // Click island → open player below it
    this.island?.addEventListener("click", () => {
      if (!this.isExpanded) this.openPlayer();
    });

    // Click backdrop → close player
    this.backdropEl?.addEventListener("click", () => this.closePlayer());

    // Song change
    window.addEventListener("music:songChange", ((e: CustomEvent) => {
      this.onSongChange(e.detail);
    }) as EventListener);

    // Audio events
    if (this.audio) {
      this.audio.addEventListener("timeupdate", () => this.onTimeUpdate());
      this.audio.addEventListener("play", () => this.onPlay());
      this.audio.addEventListener("pause", () => this.onPause());
    }
  }

  private syncWithPlayer() {
    if (this.audio && !this.audio.paused && this.audio.src) {
      this.onPlay();
    }
    // Fallback poll
    setInterval(() => {
      const title = document.getElementById("player-mini-title")?.textContent;
      const cover = (document.getElementById("player-mini-cover") as HTMLImageElement)?.src;
      if (title && title !== "未播放") {
        this.hasSong = true;
        this.updateCover(cover || "");
        if (!this.audio?.paused) this.showPlayingPill();
        else if (!this.isExpanded) this.showPlayingPill(); // show pill state for paused song
      }
    }, 1000);
  }

  // ===== Play / Pause =====

  private onPlay() {
    this.showPlayingPill();
    document.getElementById("di-waveform")?.classList.add("active");
    document.getElementById("di-cover")?.classList.add("playing");
  }

  private onPause() {
    document.getElementById("di-waveform")?.classList.remove("active");
    document.getElementById("di-cover")?.classList.remove("playing");
  }

  private showPlayingPill() {
    if (!this.island || this.isExpanded) return;
    this.island.className = "dynamic-island di-playing-pill";
    document.getElementById("di-idle")?.classList.add("hidden");
    document.getElementById("di-playing")?.classList.remove("hidden");
  }

  private onSongChange(detail: any) {
    if (detail) {
      this.hasSong = true;
      this.updateCover(detail.cover);
      this.fetchLyrics(detail.id);
    }
  }

  private updateCover(cover: string) {
    const el = document.getElementById("di-cover") as HTMLImageElement;
    if (el && cover) el.src = cover;
  }

  // ===== Open / Close the REAL player panel =====
  // Island pill stays the same size — only the player panel appears/disappears

  private openPlayer() {
    const playerEl = document.getElementById("global-music-player");
    const fullEl = document.getElementById("player-full");
    const miniEl = document.getElementById("player-mini");
    if (!playerEl || !fullEl) return;

    this.isExpanded = true;

    // Calculate position below the island
    const diContainer = document.getElementById("di-container");
    if (!diContainer) return;
    const rect = diContainer.getBoundingClientRect();

    // Position the player fixed, centered below the island
    playerEl.style.cssText = `
      position: fixed !important;
      top: ${rect.bottom + 8}px !important;
      left: ${rect.left + rect.width / 2}px !important;
      transform: translateX(-50%) !important;
      bottom: auto !important;
      z-index: 200 !important;
      padding-left: 0 !important;
    `;

    // Show full panel, hide mini
    playerEl.classList.remove("hidden");
    miniEl?.classList.add("hidden");
    fullEl.classList.remove("hidden");

    // Morph animation: scale from island pill shape
    fullEl.style.cssText = `
      opacity: 0;
      transform: scaleY(0) scaleX(0.5);
      transform-origin: top center;
      transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                  transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    `;

    this.backdropEl?.classList.remove("hidden");

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        fullEl.style.opacity = "1";
        fullEl.style.transform = "scaleY(1) scaleX(1)";
      });
    });
  }

  private closePlayer() {
    const playerEl = document.getElementById("global-music-player");
    const fullEl = document.getElementById("player-full");
    if (!playerEl || !fullEl) return;

    // Morph out animation
    fullEl.style.opacity = "0";
    fullEl.style.transform = "scaleY(0) scaleX(0.5)";

    this.backdropEl?.classList.add("hidden");

    setTimeout(() => {
      this.isExpanded = false;
      // Reset all inline styles
      playerEl.style.cssText = "";
      fullEl.style.cssText = "";
      playerEl.classList.add("hidden");
      // Island pill stays as-is, no size change needed
    }, 400);
  }

  // ===== Lyrics =====

  private onTimeUpdate() {
    if (!this.audio) return;
    const { currentTime, duration } = this.audio;
    if (!duration) return;
    this.updateLyric(currentTime);
  }

  private updateLyric(time: number) {
    if (this.lyrics.length === 0) return;
    let idx = -1;
    for (let i = this.lyrics.length - 1; i >= 0; i--) {
      if (time >= this.lyrics[i].time) { idx = i; break; }
    }
    if (idx !== this.currentLyricIndex && idx >= 0) {
      this.currentLyricIndex = idx;
      const text = this.lyrics[idx].text || "♪";
      const lyricEl = document.getElementById("di-lyric");
      if (lyricEl) {
        lyricEl.style.opacity = "0";
        setTimeout(() => { lyricEl.textContent = text; lyricEl.style.opacity = "1"; }, 150);
      }
    }
  }

  private async fetchLyrics(songId: number | string) {
    this.lyrics = [];
    this.currentLyricIndex = -1;
    try {
      const isLocal = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
      const api = isLocal ? "http://localhost:9898/blog/music" : "https://api.yukiryou.icu/blog/music";
      const res = await fetch(`${api}/lyric?id=${songId}`);
      const data = await res.json();
      if (data.code === 200 && data.data?.lrc?.lyric) {
        this.lyrics = this.parseLRC(data.data.lrc.lyric);
      }
    } catch (e) { /* ignore */ }
  }

  private parseLRC(lrc: string): Array<{time: number, text: string}> {
    const result: Array<{time: number, text: string}> = [];
    for (const line of lrc.split("\n")) {
      const m = line.match(/\[(\d{2}):(\d{2})\.(\d{2,3})\]/);
      if (m) {
        const t = parseInt(m[1]) * 60 + parseInt(m[2]) + parseInt(m[3].padEnd(3, "0")) / 1000;
        const txt = line.replace(/\[\d{2}:\d{2}\.\d{2,3}\]/g, "").trim();
        if (txt) result.push({ time: t, text: txt });
      }
    }
    return result.sort((a, b) => a.time - b.time);
  }
}

function initDI() { new DynamicIsland(); }
initDI();
document.addEventListener("astro:page-load", initDI);
</script>
