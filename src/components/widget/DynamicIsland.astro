---
/**
 * Dynamic Island — Apple-style pill in the navbar center
 * States: Idle (clock) → Playing (cover+lyric+waveform) → Pause 5s → Idle
 */
---

<div id="dynamic-island" class="dynamic-island di-idle" title="音乐播放器">
  <!-- Idle: Beijing time clock -->
  <div id="di-idle" class="di-pill-idle">
    <span id="di-clock" class="di-clock">00:00:00</span>
  </div>
  <!-- Playing: cover + waveform (lyrics reserved) -->
  <div id="di-playing" class="di-pill-playing hidden">
    <img id="di-cover" src="" alt="" class="di-cover cover-spin" />
    <div id="di-lyric" class="di-lyric hidden">♪ 播放中</div>
    <div class="di-waveform" id="di-waveform">
      <span></span><span></span><span></span><span></span>
    </div>
  </div>
</div>

<!-- Backdrop for click-away -->
<div id="di-backdrop" class="di-backdrop hidden"></div>

<style>
  /* ===== Island pill ===== */
  .dynamic-island {
    position: fixed;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
    border-radius: 99px;
    cursor: pointer;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
    z-index: 9999;
    overflow: hidden;
    flex-shrink: 0;
    transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.3s ease;
  }
  .dynamic-island:hover {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
  }

  /* Idle */
  .dynamic-island.di-idle {
    width: 110px;
    height: 32px;
    padding: 0 14px;
  }

  /* Clock */
  .di-clock {
    font-family: 'SF Mono', 'Menlo', 'Consolas', 'Monaco', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  /* Playing - default compact */
  .dynamic-island.di-playing-pill {
    width: 120px;
    height: 34px;
    padding: 0 12px;
  }
  
  /* Playing - with lyrics enabled */
  .dynamic-island.di-playing-pill.with-lyric {
    width: 180px;
  }

  /* Inner states */
  .di-pill-idle, .di-pill-playing {
    display: flex;
    align-items: center;
    width: 100%;
  }
  .di-pill-idle.hidden, .di-pill-playing.hidden {
    display: none !important;
  }
  .di-pill-idle { justify-content: center; }
  .di-pill-playing { justify-content: space-between; }
  .dynamic-island.with-lyric .di-pill-playing { gap: 8px; justify-content: flex-start; }

  /* Cover */
  .di-cover {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    background: #333;
    flex-shrink: 0;
  }

  /* Lyric (Reserved) */
  .di-lyric {
    flex: 1;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.85);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    transition: opacity 0.15s ease;
  }
  .di-lyric.hidden {
    display: none !important;
  }

  /* Waveform — only .active animates */
  .di-waveform {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 16px;
    flex-shrink: 0;
  }
  .di-waveform span {
    display: block;
    width: 2px;
    background: oklch(0.7 0.18 var(--hue));
    border-radius: 1px;
    height: 4px;
    transition: height 0.2s ease;
  }
  .di-waveform.active span {
    animation: diWave 1.2s ease-in-out infinite;
  }
  .di-waveform.active span:nth-child(1) { animation-delay: 0s; }
  .di-waveform.active span:nth-child(2) { animation-delay: 0.2s; }
  .di-waveform.active span:nth-child(3) { animation-delay: 0.4s; }
  .di-waveform.active span:nth-child(4) { animation-delay: 0.6s; }
  @keyframes diWave {
    0%, 100% { height: 4px; }
    50% { height: 14px; }
  }

  /* Backdrop */
  .di-backdrop {
    position: fixed;
    inset: 0;
    z-index: 95;
    background: transparent;
  }

  /* Cover spin */
  .cover-spin {
    animation: spin 12s linear infinite;
    animation-play-state: paused;
  }
  .cover-spin.playing { animation-play-state: running; }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .dynamic-island.di-playing-pill { width: 110px; }
    .dynamic-island.di-playing-pill.with-lyric { width: 150px; }
  }
</style>

<script>
// ===== Singleton guard =====
declare global {
  interface Window { __diInstance?: any; __diClockId?: number; __diPollId?: number; }
}

(function initDynamicIsland() {
  // Clean up previous instance
  if (window.__diClockId) { clearInterval(window.__diClockId); window.__diClockId = undefined; }
  if (window.__diPollId) { clearInterval(window.__diPollId); window.__diPollId = undefined; }

  const island = document.getElementById("dynamic-island");
  const idleEl = document.getElementById("di-idle");
  const playingEl = document.getElementById("di-playing");
  const lyricEl = document.getElementById("di-lyric");
  const clockEl = document.getElementById("di-clock");
  const coverEl = document.getElementById("di-cover") as HTMLImageElement | null;
  const waveformEl = document.getElementById("di-waveform");
  const backdropEl = document.getElementById("di-backdrop");
  const audio = document.getElementById("global-audio") as HTMLAudioElement | null;

  if (!island) return;

  // 🌟 歌词开关
  const enableLyrics = true;

  let state: "idle" | "playing" = "idle";
  let isExpanded = false;
  let pauseTimer: ReturnType<typeof setTimeout> | null = null;
  let lyrics: Array<{time: number, text: string}> = [];
  let currentLyricIndex = -1;

  // ===== Force idle on init =====
  function showIdle() {
    if (isExpanded) return;
    state = "idle";
    island!.className = "dynamic-island di-idle";
    if (idleEl) idleEl.classList.remove("hidden");
    if (playingEl) playingEl.classList.add("hidden");
    if (lyricEl) lyricEl.classList.add("hidden");
  }

  function showPlaying() {
    if (isExpanded) return;
    state = "playing";
    island!.className = enableLyrics
      ? "dynamic-island di-playing-pill with-lyric"
      : "dynamic-island di-playing-pill";
    if (idleEl) idleEl.classList.add("hidden");
    if (playingEl) playingEl.classList.remove("hidden");
    if (enableLyrics && lyricEl) lyricEl.classList.remove("hidden");
  }

  // Start in idle
  showIdle();

  // ===== Clock =====
  function updateClock() {
    if (!clockEl) return;
    clockEl.textContent = new Date().toLocaleTimeString('zh-CN', {
      timeZone: 'Asia/Shanghai', hour12: false,
      hour: '2-digit', minute: '2-digit', second: '2-digit'
    });
  }
  updateClock();
  window.__diClockId = setInterval(updateClock, 1000) as unknown as number;

  // ===== Audio events =====
  function onPlay() {
    if (pauseTimer) { clearTimeout(pauseTimer); pauseTimer = null; }
    showPlaying();
    waveformEl?.classList.add("active");
    coverEl?.classList.add("playing");
  }

  function onPause() {
    waveformEl?.classList.remove("active");
    coverEl?.classList.remove("playing");
    // 暂停 5 秒后自动切换回时钟
    if (pauseTimer) clearTimeout(pauseTimer);
    pauseTimer = setTimeout(() => {
      if (audio?.paused && !isExpanded) {
        showIdle();
      }
    }, 5000);
  }

  if (audio) {
    audio.addEventListener("play", onPlay);
    audio.addEventListener("pause", onPause);
    if (enableLyrics) {
      audio.addEventListener("timeupdate", () => {
        if (!audio.duration) return;
        updateLyric(audio.currentTime);
      });
    }
    // If already playing
    if (!audio.paused && audio.src) onPlay();
  }

  // ===== Fallback poll =====
  window.__diPollId = setInterval(() => {
    const cover = (document.getElementById("player-mini-cover") as HTMLImageElement)?.src;
    if (cover && coverEl) coverEl.src = cover;
    // Only force playing if audio is truly playing and we're in idle
    if (audio && !audio.paused && state === "idle" && !isExpanded) {
      showPlaying();
    }
  }, 3000) as unknown as number;

  // ===== Song change =====
  window.addEventListener("music:songChange", ((e: CustomEvent) => {
    if (e.detail) {
      if (e.detail.cover && coverEl) coverEl.src = e.detail.cover;
      if (enableLyrics && e.detail.id) fetchLyrics(e.detail.id);
    }
  }) as EventListener);

  // ===== Click handlers =====
  island.addEventListener("click", () => {
    if (isExpanded) closePlayer();
    else openPlayer();
  });
  backdropEl?.addEventListener("click", () => closePlayer());

  // ===== Open / Close player =====
  function openPlayer() {
    const playerEl = document.getElementById("global-music-player");
    const fullEl = document.getElementById("player-full");
    const miniEl = document.getElementById("player-mini");
    if (!playerEl || !fullEl || !island) return;

    isExpanded = true;
    const rect = island.getBoundingClientRect();

    playerEl.style.cssText = `
      position: fixed !important;
      top: ${rect.bottom + 8}px !important;
      left: ${rect.left + rect.width / 2}px !important;
      transform: translateX(-50%) !important;
      bottom: auto !important;
      z-index: 200 !important;
      padding-left: 0 !important;
    `;
    playerEl.classList.remove("hidden");
    miniEl?.classList.add("hidden");
    fullEl.classList.remove("hidden");

    fullEl.style.cssText = `
      opacity: 0; transform: scaleY(0) scaleX(0.5);
      transform-origin: top center;
      transition: opacity 0.35s cubic-bezier(0.4,0,0.2,1), transform 0.4s cubic-bezier(0.4,0,0.2,1);
    `;
    backdropEl?.classList.remove("hidden");
    requestAnimationFrame(() => requestAnimationFrame(() => {
      fullEl.style.opacity = "1";
      fullEl.style.transform = "scaleY(1) scaleX(1)";
    }));
  }

  function closePlayer() {
    const playerEl = document.getElementById("global-music-player");
    const fullEl = document.getElementById("player-full");
    if (!playerEl || !fullEl) return;

    fullEl.style.opacity = "0";
    fullEl.style.transform = "scaleY(0) scaleX(0.5)";
    backdropEl?.classList.add("hidden");

    setTimeout(() => {
      isExpanded = false;
      playerEl.style.cssText = "";
      fullEl.style.cssText = "";
      playerEl.classList.add("hidden");
    }, 400);
  }

  // ===== Lyrics =====
  function updateLyric(time: number) {
    if (lyrics.length === 0) return;
    let idx = -1;
    for (let i = lyrics.length - 1; i >= 0; i--) {
      if (time >= lyrics[i].time) { idx = i; break; }
    }
    if (idx !== currentLyricIndex && idx >= 0) {
      currentLyricIndex = idx;
      const text = lyrics[idx].text || "♪";
      if (lyricEl) {
        lyricEl.style.opacity = "0";
        setTimeout(() => { lyricEl.textContent = text; lyricEl.style.opacity = "1"; }, 150);
      }
    }
  }

  async function fetchLyrics(songId: number | string) {
    lyrics = []; currentLyricIndex = -1;
    try {
      const isLocal = location.hostname === "localhost" || location.hostname === "127.0.0.1";
      const api = isLocal ? "http://localhost:9898/blog/music" : "https://api.yukiryou.icu/blog/music";
      const res = await fetch(`${api}/lyric?id=${songId}`);
      const data = await res.json();
      if (data.code === 200 && data.data?.lrc?.lyric) {
        lyrics = parseLRC(data.data.lrc.lyric);
      }
    } catch (e) { /* ignore */ }
  }

  function parseLRC(lrc: string) {
    const result: Array<{time: number, text: string}> = [];
    for (const line of lrc.split("\n")) {
      const m = line.match(/\[(\d{2}):(\d{2})\.(\d{2,3})\]/);
      if (m) {
        const t = parseInt(m[1]) * 60 + parseInt(m[2]) + parseInt(m[3].padEnd(3, "0")) / 1000;
        const txt = line.replace(/\[\d{2}:\d{2}\.\d{2,3}\]/g, "").trim();
        if (txt) result.push({ time: t, text: txt });
      }
    }
    return result.sort((a, b) => a.time - b.time);
  }
})();

// Re-init on Astro page transitions
document.addEventListener("astro:page-load", () => {
  // The IIFE above runs on initial load. For page transitions,
  // we need to re-init. The cleanup at the top handles old intervals.
  const script = document.querySelector('#dynamic-island')?.closest('astro-island');
  if (script) {
    // Astro will re-run the script automatically on page transitions
  }
});
</script>
